# WhatsApp Auto Sticker - Configurações

NODE_ENV=development

# Automação de stickers por tipo
AUTO_STICKER=true
AUTO_IMAGE=true
AUTO_VIDEO=true
AUTO_GIF=true

# Regras de filtro (IGNORE_GROUPS é sempre ativo por segurança)
IGNORE_GROUPS=true
IGNORE_OWN_MESSAGES=true

# Habilitação de comandos manuais em conversas privadas
COMMANDS_ENABLED=true

# Limites de tamanho de entrada (em MB)
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=20
MAX_GIF_SIZE_MB=20

# Duração máxima para figurinhas animadas (em segundos)
MAX_VIDEO_DURATION_SECONDS=10

# Limite de jobs concorrentes na fila
MAX_CONCURRENT_JOBS=2

# Modo de corte para vídeos que excedem a duração ('first' para os primeiros segundos)
VIDEO_TRIM_MODE=first

# Nível de log do Pino (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Caminho para o executável do FFmpeg (se vazio, busca no PATH do sistema ou fallback)
FFMPEG_PATH=

# Conexão no próprio celular sem QR Code (Código de Pareamento de 8 dígitos)
# Deixe vazio para usar QR Code, ou informe seu número com DDI e DDD (ex: 5511999998888)
PAIRING_NUMBER=

# Marca pessoal nas Figurinhas (Metadados EXIF)
STICKER_PACK_NAME="𝔗𝔥𝔦𝔞𝔤𝔬 ℑ𝔟𝔯𝔞𝔥𝔦𝔪"
STICKER_PACK_AUTHOR="@𝚝𝚑𝚒𝚊𝚐𝚘_𝚙𝚕𝚊𝚢𝚎𝚛𝟾𝟿𝟶"
